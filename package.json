{
  "name": "opencode-anthropic-login-via-cli",
  "version": "1.4.0",
  "description": "OpenCode plugin that syncs your Claude CLI OAuth token to use Anthropic models with your Claude Pro/Max subscription.",
  "keywords": [
    "anthropic",
    "claude",
    "oauth",
    "opencode",
    "plugin",
    "token-sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cemalturkcan/opencode-anthropic-login-via-cli.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --randomize",
    "test:coverage": "bun test --randomize --coverage",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run build && bun run test:coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "@oxlint/plugins": "1.87.0",
    "bun-types": "1.4.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "chore",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "bun@1.4.3"
}
